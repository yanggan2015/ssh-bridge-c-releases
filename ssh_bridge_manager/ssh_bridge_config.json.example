{
    "eadk": {
        "tool": "ssh-bridge"
    },
    "default": {
        "username": "root",
        "password": "",
        "buffer_size": 1048576,
        "log_enabled": true,
        "log_dir": "./logs",
        "http_port": 18081
    },
    "boards": {
        "board-win": {
            "enable": true,
            "discoverable": false,
            "port": 2201,
            "serial_device": "COM3",
            "baudrate": 115200,
            "databits": 8,
            "parity": "none",
            "stopbits": "1",
            "flowcontrol": "none",
            "dtr": true,
            "rts": true,
            "line_ending": "crlf",
            "encoding": "utf-8",
            "auto_open": true,
            "timestamp": true
        },
        "board-linux": {
            "enable": false,
            "port": 2202,
            "serial_device": "/dev/ttyUSB0",
            "baudrate": 1500000,
            "databits": 8,
            "parity": "none",
            "stopbits": "1",
            "flowcontrol": "none",
            "dtr": true,
            "rts": true,
            "line_ending": "lf",
            "encoding": "utf-8",
            "auto_open": true,
            "timestamp": true
        }
    },
    "ssh": {
        "yocto-build": {
            "enable": true,
            "discoverable": false,
            "port": 2301,
            "target_host": "192.168.1.10",
            "target_port": 22,
            "target_username": "root",
            "target_password": "changeme",
            "timestamp": true
        },
        "docker-host": {
            "enable": false,
            "port": 2302,
            "target_host": "10.0.0.20",
            "target_port": 22,
            "target_username": "user",
            "target_password": "changeme"
        }
    }
}
