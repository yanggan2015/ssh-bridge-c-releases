        "allow_write": true
    },
    "tunnel": {
        "server_addr": "39.97.234.200",
        "server_port": 7321,
        "token": "sdafsdafdsnvsdafsdfsdafsdavsavso23oy47r32trvnasbhguyfgbfnahuinhyvgrhn",
        "dashboard_port": 7322,
        "dashboard_user": "admin",
        "dashboard_password": "fsdafsdfsdafsdafsdfsdafsdafcvsjklwjvmi34u8384tosfhnvet8yt7834nygetuyeritb3nuygbn",
        "local_host": "127.0.0.1",
        "local_port": 0,
